# Copy to docker/.env and adjust. Compose reads it automatically.

POSTGRES_USER=villaos
POSTGRES_PASSWORD=villaos
POSTGRES_DB=villaos

# Host-side ports for Postgres and Redis. Both are bound to 127.0.0.1 and are
# only needed by local DB clients — the API talks to them over the compose
# network. On a host that already runs Postgres or Redis, the container will
# fail to start with "address already in use"; pick free ports here, e.g.
# POSTGRES_PORT=55432.
POSTGRES_PORT=5432
REDIS_PORT=6380

# Required — compose refuses to start while either is empty. Generate one value
# per secret; they must differ from each other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=604800

# Safe to change: the web app reaches the API through nginx on WEB_PORT, so
# neither value is baked into the built bundle. API_PORT only exposes the API
# directly (Swagger, debugging).
WEB_PORT=8083
API_PORT=8084
