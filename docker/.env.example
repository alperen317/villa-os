# Copy to docker/.env and adjust. Compose reads it automatically.

POSTGRES_USER=villaos
POSTGRES_PASSWORD=villaos
POSTGRES_DB=villaos
POSTGRES_PORT=5432

REDIS_PORT=6380

# Generate real values before exposing this beyond localhost, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL_SECONDS=604800

# Safe to change: the web app reaches the API through nginx on WEB_PORT, so
# neither value is baked into the built bundle. API_PORT only exposes the API
# directly (Swagger, debugging).
WEB_PORT=8083
API_PORT=8084
