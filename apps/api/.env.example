DATABASE_URL="postgresql://user:password@localhost:5432/villaos?schema=public"
# 6380, not 6379: docker-compose.yml publishes Redis on REDIS_PORT to avoid
# clashing with a Redis already running on the host.
REDIS_URL="redis://localhost:6380"
PORT=3333

# Number of proxies in front of the API, used to resolve the real client IP for
# rate limiting. 1 covers both nginx (container) and the Angular dev-server.
# Set to 0 when the API is exposed directly, so X-Forwarded-For is ignored.
TRUSTED_PROXY_HOPS=1

JWT_ACCESS_SECRET="your-access-secret-here"
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_TTL_SECONDS=604800
