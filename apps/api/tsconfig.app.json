{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Declaration output lives outside `dist/`: webpack builds into `dist/` with
    // `clean: true`, so sharing the directory makes `build` and `typecheck` wipe
    // each other's artifacts when Nx runs them in parallel.
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
